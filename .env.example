# Copy to .env.local for local development; set the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the site (used for canonical links, sitemap and social previews).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Contact form email delivery via https://resend.com (free tier is plenty).
# Without it, the form opens the visitor's email app instead.
RESEND_API_KEY=
# Optional — once you verify a domain in Resend, e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM=

# Optional — a GitHub token (no scopes needed) to show "Contributions in the last year".
GITHUB_TOKEN=
